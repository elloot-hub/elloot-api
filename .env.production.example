# Elloot API — variáveis para produção (Square Cloud)
# Domínios: API www.api.elloot.com.br | App www.elloot.com.br | Admin www.dashboard.elloot.com.br
# Cole no painel da aplicação (Environment Variables). NÃO commitar valores reais.
# Gerar secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Obrigatórias (API não sobe sem isto em NODE_ENV=production) ---
NODE_ENV=production
# PORT: deixe a Square Cloud injetar; só defina se o painel não setar
TRUST_PROXY=1

# URLs públicas
APP_URL=https://www.api.elloot.com.br
FRONTEND_URL=https://www.elloot.com.br
CORS_ORIGIN=https://www.elloot.com.br,https://elloot.com.br
ADMIN_FRONTEND_URL=https://www.dashboard.elloot.com.br
ADMIN_CORS_ORIGIN=https://www.dashboard.elloot.com.br,https://dashboard.elloot.com.br

# Postgres Square Cloud (URL do dashboard + cert)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_SSL_CERT_PATH=./src/databases/postgres/certificates/certificate.pem
# DATABASE_SSL_P12_PASSWORD=elloot

# Auth (mín. 32 chars; ADMIN_JWT_SECRET ≠ JWT_SECRET)
JWT_SECRET=
ADMIN_JWT_SECRET=
MEDIA_SIGNING_SECRET=
JWT_EXPIRES_IN=12h
ADMIN_JWT_EXPIRES_IN=2h

# IPs do escritório/VPN com acesso ao /api/admin (obrigatório em prod)
ADMIN_IP_ALLOWLIST=203.0.113.10

# Pagamentos — EFI live (sandbox é recusado em production)
PAYMENT_PROVIDER=efi
EFI_SANDBOX=false
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=./src/databases/efi/producao.p12
EFI_CERT_PASSPHRASE=
EFI_PIX_KEY=

# Mídia — use S3/R2 (disco local some no redeploy)
MEDIA_DRIVER=s3
MEDIA_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
MEDIA_S3_REGION=auto
MEDIA_S3_BUCKET=elloot-media
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_FORCE_PATH_STYLE=true
# MEDIA_PUBLIC_BASE_URL=https://cdn.elloot.com.br

# --- Fortemente recomendadas ---
# REDIS_URL=rediss://USER:PASSWORD@HOST:PORT
# REDIS_SSL_CERT_PATH=./src/databases/redis/certificates/certificate.pem
JOB_SECRET=
JOB_POLL_MS=60000

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Elloot <noreply@elloot.com.br>

# OAuth (opcional) — redirect URIs no provedor:
#   https://www.api.elloot.com.br/api/auth/google/callback
#   https://www.api.elloot.com.br/api/auth/discord/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# Web Push (opcional)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@elloot.com.br

PLATFORM_FEE_BPS=1000
ESCROW_AUTO_RELEASE_HOURS=48
