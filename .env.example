# Copy to .env and/or .env.local
# Priority: .env.local overrides .env

# Server
PORT=3333
NODE_ENV=development
APP_URL=http://localhost:3333
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL
# Local: docker compose (no SSL)
# Square Cloud: connection URL + certificate.pem from dashboard
# Docs: https://docs.squarecloud.app/pt-br/services/databases
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elloot?schema=public
# Square Cloud (Prisma no Windows precisa do .p12 gerado a partir do .pem):
# DATABASE_SSL_CERT_PATH=./src/databases/postgres/certificates/certificate.pem
# DATABASE_SSL_P12_PASSWORD=elloot

# ---------------------------------------------------------------------------
# Redis
# Local: redis://localhost:6379
# Square Cloud: rediss://... + certificate under redis/certificates
# ---------------------------------------------------------------------------
# Leave REDIS_URL empty to run without Redis (checkout reserve uses DB only)
# REDIS_URL=redis://localhost:6379
# REDIS_SSL_CERT_PATH=./src/databases/redis/certificates/certificate.pem
# REDIS_SSL_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Auth — NEVER use the placeholder below in real environments.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars-min
MEDIA_SIGNING_SECRET=replace-with-a-different-long-random-secret-32plus
JWT_EXPIRES_IN=12h

# Admin panel (elloot-admin) — MUST differ from JWT_SECRET
ADMIN_JWT_SECRET=replace-with-another-long-random-secret-for-admin-only
ADMIN_JWT_EXPIRES_IN=2h
ADMIN_CORS_ORIGIN=http://localhost:3001
ADMIN_FRONTEND_URL=http://localhost:3001
# Reverse-proxy hops for req.ip / rate-limit (default 1)
# TRUST_PROXY=1

# Sandbox payments: defaults to off in production. Set true only for local/dev.
# ALLOW_SANDBOX_PAYMENTS=true
# PAYMENT_PROVIDER=sandbox is refused when NODE_ENV=production

# OAuth (optional — leave empty to disable a provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Google redirect URI to register:
#   {APP_URL}/api/auth/google/callback
# Discord redirect URI to register:
#   {APP_URL}/api/auth/discord/callback

# Platform
PLATFORM_FEE_BPS=1000
ESCROW_AUTO_RELEASE_HOURS=48
# Payments — Efi Pix (mTLS). Homolog: EFI_SANDBOX=true + credenciais/certificado de Homologação.
# Produção: EFI_SANDBOX=false + credenciais/certificado de Produção.
# O .p12 deve ser baixado no painel Efí (API Pix → sua aplicação → Gerar certificado).
PAYMENT_PROVIDER=efi
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=./src/databases/efi/seu-certificado-homolog.p12
EFI_CERT_PASSPHRASE=
# Se converter o certificado para PEM, informe também a chave:
# EFI_PEM_KEY_PATH=./src/databases/efi/seu-certificado-homolog.key
EFI_PIX_KEY=
EFI_SANDBOX=true
# Optional. Required to enable POST /api/payments/sandbox/webhook
# SANDBOX_WEBHOOK_SECRET=long-random-secret
# Header: x-sandbox-webhook-secret: <SANDBOX_WEBHOOK_SECRET>

# Background jobs (expire checkout + auto-release escrow)
# JOB_SECRET=long-random-secret
# Header: x-job-secret: <JOB_SECRET>
# Or call /api/jobs/* with ADMIN JWT
JOB_POLL_MS=60000

# ---------------------------------------------------------------------------
# Media CDN
# local = disk under MEDIA_LOCAL_DIR (dev)
# s3 = S3 / Cloudflare R2 / MinIO (production)
# ---------------------------------------------------------------------------
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./storage/media
# Optional public CDN base (R2 custom domain / CloudFront). Empty = API serves /api/media/:id/content
# MEDIA_PUBLIC_BASE_URL=https://cdn.elloot.com.br
# Keep the S3/R2 bucket PRIVATE; public access only via /api/media/MED-…/content
MEDIA_MAX_BYTES=5242880
# Defaults to JWT_SECRET if empty
# MEDIA_SIGNING_SECRET=
MEDIA_SIGN_TTL_SECONDS=900

# S3 / R2 (required when MEDIA_DRIVER=s3)
# MEDIA_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# MEDIA_S3_REGION=auto
# MEDIA_S3_BUCKET=elloot-media
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_FORCE_PATH_STYLE=true

# Seed: GGMAX category cover images (filename from API → this base)
# GGMAX_CATEGORY_MEDIA_BASE=https://cdn.ggmax.com.br/category-images

# ---------------------------------------------------------------------------
# Web Push (optional — leave empty to disable browser notifications)
# Generate keys: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@elloot.local

# ---------------------------------------------------------------------------
# SMTP (password reset). All four of HOST/USER/PASS/FROM required to enable.
# Port 465 → SMTP_SECURE=true; 587 → SMTP_SECURE=false (STARTTLS)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Elloot <noreply@elloot.com.br>
# PASSWORD_RESET_LOG_LINKS=true

